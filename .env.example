# Puerto del servidor
PORT=3000

# Contraseña para entrar a /admin (use una larga y única)
ADMIN_PASSWORD=cambie-esta-contraseña

# Clave secreta para las sesiones del admin (cualquier texto largo y aleatorio)
SESSION_SECRET=reemplace-con-texto-largo-aleatorio

# ---- Notificaciones por correo de cada mensaje del formulario ----
# Correo(s) que reciben los mensajes de clientes (varios separados por coma)
NOTIFY_TO=recepcion@rudelmanlaw.com

# Servidor SMTP que envía el aviso. Ejemplos:
#  Google Workspace / Gmail: SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  (usar "contraseña de aplicación")
#  Microsoft 365 / Outlook:  SMTP_HOST=smtp.office365.com  SMTP_PORT=587
#  Resend:                   SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend  SMTP_PASS=<api key>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Rudelman Law Website <web@rudelmanlaw.com>"

# Carpeta donde se guardan la base de datos y las fotos (opcional)
# DATA_DIR=./data
